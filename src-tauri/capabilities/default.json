{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Calqo desktop capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-start-dragging",
    "dialog:default",
    "opener:default",
    "store:default",
    "stronghold:default",
    "updater:default",
    "process:allow-restart",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-image",
    "clipboard-manager:allow-write-text",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$TEMP/calqo-export-*.mp4"
        }
      ]
    },
    "fs:allow-remove"
  ]
}
