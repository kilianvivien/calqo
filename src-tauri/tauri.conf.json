{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calqo",
  "version": "0.7.0",
  "identifier": "dev.calqo.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' blob: data:",
        "media-src": "'self' blob: data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' data: ipc: http://ipc.localhost https: http:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' blob: data:",
        "media-src": "'self' blob: data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' data: ipc: http://ipc.localhost https: http: ws: wss:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      }
    },
    "windows": [
      {
        "title": "Calqo",
        "label": "main",
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 680,
        "visible": false,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 18,
          "y": 25
        },
        "dragDropEnabled": true
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kilianvivien/calqo/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZENjY4QTUwNEZDQTgwMTkKUldRWmdNcFBVSXBtL1hGbndvK0F4bysxc3BBVWpDNFNPR1JiQm1zVnA2S09FZDlCREVnMFo5MTEK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "GraphicsAndDesign",
    "shortDescription": "A simple, glass-native social visual maker",
    "longDescription": "Calqo is a local-first maker for static social posts, thumbnails, stories, and banners.",
    "copyright": "Copyright \u00a9 2026 Calqo contributors",
    "createUpdaterArtifacts": false,
    "icon": ["../public/calqo-icon.png", "../public/calqo-icon@2x.png"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
